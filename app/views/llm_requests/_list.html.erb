<section>
  <div class="mb-4"><h2 class="text-lg font-bold"><%= local_assigns.fetch(:title, "LLM API activity") %></h2><p class="mt-1 text-xs text-slate-500"><%= local_assigns.fetch(:description, "Exact prompts, request payloads, raw responses, timing, usage, and errors. Credentials are never stored.") %></p></div>
  <% if llm_requests.any? %>
    <div class="card divide-y divide-slate-100 overflow-hidden">
      <% llm_requests.each do |request_log| %>
        <%= link_to request_log, class: "group flex items-center gap-4 p-4 transition hover:bg-slate-50" do %>
          <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-slate-100 font-mono text-[11px] font-bold text-slate-600">#<%= request_log.id %></span>
          <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="text-sm font-bold"><%= request_log.display_purpose %></h3><%= status_badge(request_log.status) %></div><p class="mt-1 truncate font-mono text-[11px] text-slate-500"><%= request_log.model_requested %><% if request_log.scrape_source %> · <%= request_log.scrape_source.host %><% end %></p></div>
          <div class="hidden shrink-0 text-right sm:block"><p class="text-xs font-semibold text-slate-600"><%= request_log.duration_ms ? "#{number_with_delimiter(request_log.duration_ms)} ms" : "In progress" %></p><p class="mt-1 text-[10px] text-slate-400"><%= request_log.created_at.strftime("%b %-d · %-I:%M:%S %p") %></p></div>
          <%= icon(:arrow, classes: "size-4 shrink-0 text-slate-300 transition group-hover:translate-x-1 group-hover:text-indigo-500") %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card border-dashed p-6 text-sm text-slate-500"><%= local_assigns.fetch(:empty_message, "No LLM API requests have been recorded yet.") %></div>
  <% end %>
</section>
