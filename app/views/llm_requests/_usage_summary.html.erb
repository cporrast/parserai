<section>
  <div class="mb-4"><h2 class="text-lg font-bold"><%= local_assigns.fetch(:title, "LLM usage") %></h2><p class="mt-1 text-xs text-slate-500">Totals use the provider-reported usage stored with each API request. Cost remains zero when OpenRouter does not return it.</p></div>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-5">
    <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Requests</p><p class="mt-2 text-xl font-bold"><%= number_with_delimiter(summary.request_count) %></p><p class="mt-1 text-[10px] text-slate-400"><%= pluralize(summary.failed_count, "failure") %></p></div>
    <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Input tokens</p><p class="mt-2 text-xl font-bold"><%= number_with_delimiter(summary.prompt_tokens) %></p></div>
    <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Output tokens</p><p class="mt-2 text-xl font-bold"><%= number_with_delimiter(summary.completion_tokens) %></p></div>
    <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Reported cost</p><p class="mt-2 text-xl font-bold"><%= number_to_currency(summary.cost, precision: 6) %></p></div>
    <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Average latency</p><p class="mt-2 text-xl font-bold"><%= summary.average_duration_ms ? "#{number_with_delimiter(summary.average_duration_ms)} ms" : "—" %></p></div>
  </div>
  <% if summary.models.any? %><p class="mt-3 text-[11px] text-slate-500"><strong>Models:</strong> <%= summary.models.first(4).map { |model, count| "#{model} (#{count})" }.join(" · ") %></p><% end %>
</section>
