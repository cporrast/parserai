<% content_for :title, "Output ##{@output.id} · ParserAI" %>

<div class="mx-auto max-w-6xl">
  <%= link_to "← Back to execution ##{@output.scrape_execution_id}", @output.scrape_execution, class: "mb-6 inline-flex text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><div class="mb-3 flex items-center gap-2"><%= status_badge(@output.status) %><span class="text-xs font-bold uppercase tracking-wider text-slate-400"><%= @output.kind %> output</span></div><h1 class="text-2xl font-bold tracking-tight">Stored output #<%= @output.id %></h1><p class="mt-2 text-sm text-slate-500"><%= @output.model.presence || "Unknown model" %> · <%= @output.generated_at&.strftime("%B %-d, %Y at %-I:%M %p") %></p></div><% if @output.status == "completed" %><%= link_to export_extraction_output_path(@output), class: "btn-primary shrink-0" do %><%= icon(:download, classes: "size-4") %> Export <%= @output.scrape_execution.output_format.upcase %><% end %><% end %></div>

  <% if @output.error_message.present? %><div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><span class="font-bold">Attempt failed:</span> <%= @output.error_message %></div><% end %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
    <section class="card overflow-hidden"><div class="border-b border-slate-100 px-5 py-4 text-sm font-bold">Parsed data</div><pre class="min-h-96 max-h-[720px] overflow-auto bg-slate-950 p-5 font-mono text-xs leading-6 text-slate-200"><%= pretty_json(@output.data) %></pre></section>
    <aside class="space-y-4"><section class="card p-5"><h2 class="text-sm font-bold">Usage</h2><dl class="mt-4 space-y-3 text-xs"><% (@output.usage || {}).each do |key, value| %><div class="flex justify-between gap-3"><dt class="text-slate-500"><%= key.humanize %></dt><dd class="font-bold"><%= number_with_delimiter(value) %></dd></div><% end %><% if @output.usage.blank? %><p class="text-xs text-slate-500">No token usage recorded.</p><% end %></dl></section><% if @output.scrape_source %><%= link_to @output.scrape_source, class: "card group flex items-center justify-between p-5 text-sm font-bold hover:border-indigo-200" do %><span>View source snapshot</span><%= icon(:arrow, classes: "size-4 text-slate-400 group-hover:text-indigo-600") %><% end %><% end %><% if @output.prompt.present? %><details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Stored prompt</summary><pre class="max-h-96 overflow-auto whitespace-pre-wrap border-t border-slate-100 bg-slate-50 p-4 text-[11px] leading-5 text-slate-600"><%= @output.prompt %></pre></details><% end %><% if @output.raw_response.present? %><details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Raw model response</summary><pre class="max-h-96 overflow-auto whitespace-pre-wrap border-t border-slate-100 bg-slate-50 p-4 font-mono text-[10px] leading-5 text-slate-600"><%= @output.raw_response %></pre></details><% end %></aside>
  </div>
</div>
