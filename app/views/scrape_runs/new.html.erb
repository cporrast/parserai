<% content_for :title, "New workflow · #{@project.name} · ParserAI" %>

<div class="mx-auto max-w-4xl">
  <%= link_to "← Back to #{@project.name}", @project, class: "mb-6 inline-flex text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mb-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-600">New extraction workflow</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Design first. Run when ready.</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">Save and revise the URLs, instructions, schema, and schedule without fetching a page or spending model tokens.</p>
  </div>
  <%= render "form", project: @project, scrape_run: @scrape_run %>
</div>
