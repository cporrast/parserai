<% content_for :title, "#{@scrape_run.display_name} · ParserAI" %>

<div <%= "data-controller=refresh data-refresh-interval-value=3000" if @latest_execution&.active? %>>
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-slate-900" %><span>/</span><%= link_to @scrape_run.project.name, @scrape_run.project, class: "hover:text-slate-900" %><span>/</span><span class="text-slate-900">Workflow #<%= @scrape_run.id %></span>
  </nav>

  <section class="card mb-8 p-6 sm:p-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-start">
      <div class="max-w-3xl">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-200">Saved workflow</span>
          <% if @scrape_run.scheduled? %><span class="inline-flex items-center rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-700 ring-1 ring-inset ring-cyan-200"><%= @scrape_run.recurrence.humanize %></span><% end %>
        </div>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= @scrape_run.instructions.truncate(140) %></h1>
        <p class="mt-3 text-sm text-slate-500"><%= pluralize(@scrape_run.urls.size, "target page") %> · <%= @scrape_run.processing_mode_label %> · <%= @scrape_run.output_format.upcase %> · <%= pluralize(@executions.size, "execution") %></p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <%= link_to "Edit setup", edit_scrape_run_path(@scrape_run), class: "btn-secondary" %>
        <%= button_to execute_scrape_run_path(@scrape_run), class: "btn-primary cursor-pointer", disabled: @scrape_run.active?, form: { data: { turbo_confirm: "Run this workflow with the current saved configuration?" } } do %>
          <%= icon(:arrow, classes: "size-4") %><%= @scrape_run.active? ? "Running…" : "Run now" %>
        <% end %>
      </div>
    </div>
    <% if @scrape_run.scheduled? %>
      <div class="mt-6 flex items-center gap-3 rounded-xl border border-cyan-100 bg-cyan-50 px-4 py-3 text-xs text-cyan-900"><span class="size-2 rounded-full bg-cyan-500"></span><span><strong>Recurring:</strong> next execution <%= @scrape_run.next_run_at ? "#{time_ago_in_words(@scrape_run.next_run_at)} from now" : "will be scheduled shortly" %> in <%= Time.zone.name %>.</span></div>
    <% end %>
  </section>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="space-y-8">
      <section>
        <div class="mb-4 flex items-end justify-between"><div><h2 class="text-lg font-bold">Latest result</h2><p class="mt-1 text-xs text-slate-500">The most recent completed execution remains available while you edit.</p></div></div>
        <% if (output = @scrape_run.combined_output) %>
          <div class="card overflow-hidden"><div class="flex items-center justify-between border-b border-slate-100 px-5 py-3"><span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= output.scrape_execution.output_format %> preview</span><div class="flex gap-3"><%= link_to "Open execution", output.scrape_execution, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %><%= link_to "Export", export_extraction_output_path(output), class: "text-xs font-bold text-indigo-600 hover:text-indigo-800" %></div></div><pre class="max-h-[480px] overflow-auto bg-slate-950 p-5 font-mono text-xs leading-6 text-slate-200"><%= pretty_json(output.data) %></pre></div>
        <% else %>
          <div class="card grid min-h-52 place-items-center border-dashed p-8 text-center"><div><span class="mx-auto grid size-11 place-items-center rounded-xl bg-indigo-50 text-indigo-600"><%= icon(:database) %></span><p class="mt-4 text-sm font-bold">Ready when you are</p><p class="mt-1 max-w-sm text-xs leading-5 text-slate-500">Edit this workflow as many times as you need, then use Run now to create the first execution.</p></div></div>
        <% end %>
      </section>

      <section>
        <div class="mb-4"><h2 class="text-lg font-bold">Execution history</h2><p class="mt-1 text-xs text-slate-500">Each item preserves its own configuration, page snapshots, and model outputs.</p></div>
        <% if @executions.any? %>
          <div class="card divide-y divide-slate-100 overflow-hidden">
            <% @executions.each do |execution| %>
              <%= link_to execution, class: "group flex items-center gap-4 p-5 transition hover:bg-slate-50" do %>
                <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-slate-100 font-mono text-xs font-bold text-slate-600">#<%= execution.id %></span>
                <div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="text-sm font-bold">Execution <%= execution.created_at.strftime("%b %-d · %-I:%M %p") %></h3><%= status_badge(execution.status) %></div><p class="mt-1 text-xs text-slate-500"><%= execution.trigger.humanize %> · <%= pluralize(execution.scrape_sources.size, "page") %> · <%= execution.processing_mode_label %></p></div>
                <%= icon(:arrow, classes: "size-4 text-slate-300 transition group-hover:translate-x-1 group-hover:text-indigo-500") %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="card border-dashed p-6 text-sm text-slate-500">No executions yet. Saving this workflow does not run it.</div>
        <% end %>
      </section>

      <%= render "llm_requests/usage_summary", summary: @llm_usage, title: "Workflow LLM usage" %>

      <%= render "async_operations/list", async_operations: @async_operations, title: "Workflow activity" %>

      <%= render "llm_requests/list", llm_requests: @llm_requests, title: "Task API activity", description: "Every OpenRouter call made for this task, including setup suggestions and per-page extraction requests." %>
    </div>

    <aside class="space-y-5">
      <section class="card p-5"><div class="flex items-center justify-between"><h2 class="text-sm font-bold">Saved configuration</h2><%= link_to "Edit", edit_scrape_run_path(@scrape_run), class: "text-xs font-bold text-indigo-600" %></div><dl class="mt-4 space-y-4 text-xs"><div><dt class="font-semibold text-slate-400">Processing engine</dt><dd class="mt-1 font-medium text-slate-700"><%= @scrape_run.processing_mode_label %></dd></div><div><dt class="font-semibold text-slate-400">Setup model</dt><dd class="mt-1 break-all font-mono text-[11px] font-medium text-slate-700"><%= @scrape_run.effective_setup_model %></dd></div><% if @scrape_run.processing_mode == "llm" %><div><dt class="font-semibold text-slate-400">Extraction model</dt><dd class="mt-1 break-all font-mono text-[11px] font-medium text-slate-700"><%= @scrape_run.effective_extraction_model %></dd></div><div><dt class="font-semibold text-slate-400">Page representation</dt><dd class="mt-1 font-medium text-slate-700"><%= @scrape_run.content_strategy_label %></dd></div><% end %><div><dt class="font-semibold text-slate-400">Schedule</dt><dd class="mt-1 font-medium text-slate-700"><%= @scrape_run.schedule_label %></dd></div><div><dt class="font-semibold text-slate-400">Output</dt><dd class="mt-1 font-medium text-slate-700"><%= @scrape_run.output_format.upcase %></dd></div><div><dt class="font-semibold text-slate-400">Last edited</dt><dd class="mt-1 font-medium text-slate-700"><%= @scrape_run.updated_at.strftime("%b %-d, %-I:%M %p") %></dd></div></dl></section>
      <details class="card overflow-hidden" open><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Target URLs</summary><div class="space-y-2 border-t border-slate-100 p-4"><% @scrape_run.urls.each do |url| %><p class="truncate rounded-lg bg-slate-50 px-3 py-2 font-mono text-[11px] text-slate-600"><%= url %></p><% end %></div></details>
      <details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Output structure</summary><pre class="max-h-96 overflow-auto border-t border-slate-100 bg-slate-950 p-4 font-mono text-[11px] leading-5 text-slate-200"><%= @scrape_run.output_schema %></pre></details>
      <% if @scrape_run.processing_mode == "selectors" %><details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Selector rules</summary><pre class="max-h-96 overflow-auto border-t border-slate-100 bg-slate-950 p-4 font-mono text-[11px] leading-5 text-slate-200"><%= @scrape_run.selector_rules %></pre></details><% end %>
    </aside>
  </div>
</div>
