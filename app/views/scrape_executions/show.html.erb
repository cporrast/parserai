<% content_for :title, "Execution ##{@execution.id} · ParserAI" %>

<div <%= "data-controller=refresh data-refresh-interval-value=3000" if @execution.active? %>>
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500"><%= link_to @scrape_run.project.name, @scrape_run.project, class: "hover:text-slate-900" %><span>/</span><%= link_to "Workflow ##{@scrape_run.id}", @scrape_run, class: "hover:text-slate-900" %><span>/</span><span class="text-slate-900">Execution #<%= @execution.id %></span></nav>

  <section class="card mb-8 overflow-hidden">
    <div class="p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
        <div class="max-w-3xl"><div class="mb-3 flex flex-wrap items-center gap-3"><%= status_badge(@execution.status) %><span class="text-xs font-semibold text-slate-400"><%= @execution.trigger.humanize %> · <%= @execution.output_format.upcase %> · <%= pluralize(@sources.size, "source") %></span></div><h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Execution #<%= @execution.id %></h1><p class="mt-3 text-sm leading-6 text-slate-500"><%= @execution.instructions.truncate(180) %></p></div>
        <div class="flex shrink-0 gap-2"><% if @execution.combined_output %><%= link_to export_extraction_output_path(@execution.combined_output), class: "btn-primary" do %><%= icon(:download, classes: "size-4") %> Export <%= @execution.output_format.upcase %><% end %><% end %><% if @execution.active? %><%= button_to "Cancel", cancel_scrape_execution_path(@execution), class: "btn-secondary cursor-pointer text-rose-700", form: { data: { turbo_confirm: "Stop this execution after the current request finishes?" } } %><% end %><%= link_to "Workflow setup", @scrape_run, class: "btn-secondary" %></div>
      </div>
      <% if @execution.active? %><div class="mt-7"><div class="mb-2 flex justify-between text-xs font-semibold text-slate-500"><span>Processing pages</span><span><%= @execution.progress_percentage %>%</span></div><div class="h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-gradient-to-r from-indigo-500 to-cyan-400 transition-all" style="width: <%= @execution.progress_percentage %>%"></div></div></div><% end %>
    </div>
    <% if @execution.error_message.present? %><div class="border-t border-rose-100 bg-rose-50 px-6 py-4 text-sm text-rose-800 sm:px-8"><span class="font-bold">Execution stopped:</span> <%= @execution.error_message %></div><% end %>
  </section>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-8">
      <section><div class="mb-4"><h2 class="text-lg font-bold">Result preview</h2><p class="mt-1 text-xs text-slate-500">Combined output created only from successful pages in this execution.</p></div><% if (output = @execution.combined_output) %><div class="card overflow-hidden"><div class="flex items-center justify-between border-b border-slate-100 px-5 py-3"><span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%= @execution.output_format %> preview</span><%= link_to "Open full output", output, class: "text-xs font-bold text-indigo-600 hover:text-indigo-800" %></div><pre class="max-h-[520px] overflow-auto bg-slate-950 p-5 font-mono text-xs leading-6 text-slate-200"><%= pretty_json(output.data) %></pre></div><% else %><div class="card grid min-h-52 place-items-center border-dashed p-8 text-center"><div><span class="mx-auto grid size-11 place-items-center rounded-xl bg-slate-100 text-slate-500"><%= icon(:database) %></span><p class="mt-4 text-sm font-bold">No result yet</p><p class="mt-1 text-xs text-slate-500"><%= @execution.active? ? "This page refreshes while processing continues." : "Review source failures below." %></p></div></div><% end %></section>

      <section><div class="mb-4"><h2 class="text-lg font-bold">Source snapshots</h2><p class="mt-1 text-xs text-slate-500">Raw HTML and readable text retained specifically for this execution.</p></div><div class="card divide-y divide-slate-100 overflow-hidden"><% @sources.each do |source| %><%= link_to source, class: "group flex items-center gap-4 p-5 transition hover:bg-slate-50" do %><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-sky-50 text-sky-600"><%= icon(:globe, classes: "size-5") %></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="truncate text-sm font-bold"><%= source.title.presence || source.host %></h3><%= status_badge(source.status) %></div><p class="mt-1 truncate text-xs text-slate-500"><%= source.final_url.presence || source.url %></p></div><% if source.raw_html.present? %><div class="hidden text-right text-xs text-slate-400 sm:block"><p><%= number_to_human_size(source.raw_html.bytesize) %></p><p class="mt-1"><%= number_with_delimiter(source.extracted_text.to_s.length) %> chars</p></div><% end %><%= icon(:arrow, classes: "size-4 shrink-0 text-slate-300 transition group-hover:translate-x-1 group-hover:text-indigo-500") %><% end %><% end %></div></section>
    </div>

    <aside class="space-y-5">
      <section class="card p-5"><h2 class="text-sm font-bold">Execution snapshot</h2><dl class="mt-4 space-y-4 text-xs"><div><dt class="font-semibold text-slate-400">Processing engine</dt><dd class="mt-1 font-medium text-slate-700"><%= @execution.processing_mode_label %></dd></div><% if @execution.processing_mode == "llm" %><div><dt class="font-semibold text-slate-400">Page representation</dt><dd class="mt-1 font-medium text-slate-700"><%= @execution.content_strategy_label %></dd></div><div><dt class="font-semibold text-slate-400">Model</dt><dd class="mt-1 font-medium text-slate-700"><%= @execution.extraction_model %></dd></div><% end %><div><dt class="font-semibold text-slate-400">Started</dt><dd class="mt-1 font-medium text-slate-700"><%= @execution.started_at&.strftime("%b %-d, %-I:%M:%S %p") || "Not started" %></dd></div><div><dt class="font-semibold text-slate-400">Completed</dt><dd class="mt-1 font-medium text-slate-700"><%= @execution.completed_at&.strftime("%b %-d, %-I:%M:%S %p") || "—" %></dd></div></dl></section>
      <details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Instructions used</summary><p class="border-t border-slate-100 px-5 py-4 text-sm leading-6 text-slate-600"><%= @execution.instructions %></p></details>
      <details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Schema used</summary><pre class="max-h-80 overflow-auto border-t border-slate-100 bg-slate-950 p-4 font-mono text-[11px] leading-5 text-slate-200"><%= @execution.output_schema %></pre></details>
      <% if @execution.processing_mode == "selectors" %><details class="card overflow-hidden"><summary class="cursor-pointer px-5 py-4 text-sm font-bold">Selector rules used</summary><pre class="max-h-80 overflow-auto border-t border-slate-100 bg-slate-950 p-4 font-mono text-[11px] leading-5 text-slate-200"><%= @execution.selector_rules %></pre></details><% end %>
      <% if @outputs.any? %><section class="card p-5"><h2 class="text-sm font-bold">Stored attempts</h2><p class="mt-1 text-xs text-slate-500"><%= pluralize(@outputs.size, "output record") %>, including failures.</p><div class="mt-4 space-y-2"><% @outputs.first(8).each do |attempt| %><%= link_to attempt, class: "flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-xs hover:bg-slate-100" do %><span class="font-semibold"><%= attempt.kind.humanize %> · #<%= attempt.id %></span><%= status_badge(attempt.status) %><% end %><% end %></div></section><% end %>
    </aside>
  </div>
</div>
