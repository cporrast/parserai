<% content_for :title, "New project · ParserAI" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← Back to projects", projects_path, class: "mb-6 inline-flex text-sm font-semibold text-slate-500 hover:text-slate-900" %>
  <div class="mb-7">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-600">New collection</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Create a project</h1>
    <p class="mt-2 text-sm leading-6 text-slate-500">Group related scraping runs, exports, and conversations in one place.</p>
  </div>
  <div class="card p-6 sm:p-8"><%= render "form", project: @project %></div>
</div>
