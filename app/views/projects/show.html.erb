<% content_for :title, "#{@project.name} · ParserAI" %>

<div <%= "data-controller=refresh data-refresh-interval-value=2000" if @selected_operation&.active? %>>
<section class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
  <div>
    <%= link_to "Projects", projects_path, class: "text-xs font-bold uppercase tracking-[0.18em] text-indigo-600 hover:text-indigo-800" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950"><%= @project.name %></h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= @project.description.presence || "No project description yet." %></p>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <%= link_to "Edit", edit_project_path(@project), class: "btn-secondary" %>
    <%= link_to new_project_scrape_run_path(@project), class: "btn-primary" do %>
      <%= icon(:plus, classes: "size-4") %> New workflow
    <% end %>
  </div>
</section>

<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
  <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Workflows</p><p class="mt-2 text-2xl font-bold"><%= @runs.size %></p></div>
  <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Executions</p><p class="mt-2 text-2xl font-bold"><%= @runs.sum { |run| run.scrape_executions.size } %></p></div>
  <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Pages stored</p><p class="mt-2 text-2xl font-bold"><%= @runs.sum { |run| run.scrape_executions.sum { |execution| execution.scrape_sources.size } } %></p></div>
  <div class="card p-4"><p class="text-xs font-semibold text-slate-500">Model outputs</p><p class="mt-2 text-2xl font-bold"><%= @runs.sum { |run| run.scrape_executions.sum { |execution| execution.extraction_outputs.count { |output| output.kind == "source" } } } %></p></div>
</div>

<div class="mb-8">
  <%= render "llm_requests/usage_summary", summary: @llm_usage, title: "Project LLM usage" %>
</div>

<div class="mb-8">
  <%= render "async_operations/list", async_operations: @async_operations, title: "Project workflow activity" %>
</div>

<div class="mb-8">
  <%= render "llm_requests/list", llm_requests: @llm_requests, title: "Project API activity", description: "Project chat calls and setup suggestions made before a workflow was saved. Workflow-specific calls remain attached to each task." %>
</div>

<div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_380px]">
  <section>
    <div class="mb-4 flex items-center justify-between">
      <div><h2 class="text-lg font-bold">Extraction workflows</h2><p class="mt-1 text-xs text-slate-500">Editable setups with independent execution histories.</p></div>
    </div>

    <% if @runs.any? %>
      <div class="space-y-3">
        <% @runs.each do |run| %>
          <%= link_to run, class: "card group block p-5 transition hover:border-indigo-200 hover:shadow-md" do %>
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-bold text-slate-900"><%= run.display_name %></h3>
                  <% if run.latest_execution %><%= status_badge(run.latest_execution.status) %><% else %><span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-200">Draft</span><% end %>
                </div>
                <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500"><%= run.instructions %></p>
              </div>
              <%= icon(:arrow, classes: "mt-1 size-5 shrink-0 text-slate-300 transition group-hover:translate-x-1 group-hover:text-indigo-500") %>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-500">
              <span><%= pluralize(run.urls.size, "target") %></span>
              <span><%= pluralize(run.scrape_executions.size, "execution") %></span>
              <span><%= run.output_format.upcase %> output</span>
              <span><%= run.created_at.strftime("%b %-d, %Y · %-I:%M %p") %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card grid min-h-72 place-items-center border-dashed p-8 text-center">
        <div><span class="mx-auto grid size-12 place-items-center rounded-xl bg-sky-50 text-sky-600"><%= icon(:globe) %></span><h3 class="mt-4 font-bold">No workflows yet</h3><p class="mt-2 text-sm text-slate-500">Save a reusable setup, refine it, then run when ready.</p><%= link_to "Create first workflow", new_project_scrape_run_path(@project), class: "btn-primary mt-5" %></div>
      </div>
    <% end %>
  </section>

  <aside id="chat" class="card flex max-h-[740px] min-h-[560px] flex-col overflow-hidden xl:sticky xl:top-24">
    <div class="border-b border-slate-100 px-5 py-4">
      <div class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-xl bg-violet-50 text-violet-600"><%= icon(:chat, classes: "size-5") %></span><div><h2 class="text-sm font-bold">Ask about this data</h2><p class="text-[11px] text-slate-500"><%= @project.effective_chat_model %></p></div></div>
    </div>
    <div class="flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-4">
      <% if @selected_operation&.failed? %><div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><strong>Chat failed:</strong> <%= @selected_operation.error_message %></div><% end %>
      <% if @selected_operation&.active? %><div class="rounded-xl border border-violet-200 bg-violet-50 p-4 text-sm text-violet-800">Preparing an answer in the background…</div><% end %>
      <% if @chat_messages.empty? %>
        <div class="rounded-xl border border-dashed border-slate-200 bg-white p-4 text-sm leading-6 text-slate-500">Ask a quick question about completed outputs, field structure, or patterns in your collected data.</div>
      <% end %>
      <% @chat_messages.each do |message| %>
        <div class="flex <%= message.role == "user" ? "justify-end" : "justify-start" %>">
          <div class="max-w-[90%] rounded-2xl px-4 py-3 text-sm leading-6 <%= message.role == "user" ? "rounded-br-md bg-slate-950 text-white" : "rounded-bl-md border border-slate-200 bg-white text-slate-700 shadow-sm" %>">
            <%= simple_format(message.content, {}, wrapper_tag: "div") %>
          </div>
        </div>
      <% end %>
    </div>
    <%= form_with url: project_chat_messages_path(@project), scope: :chat_message, class: "border-t border-slate-100 bg-white p-4" do |form| %>
      <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
      <%= form.text_area :content, rows: 3, required: true, class: "form-input resize-none", placeholder: "What fields are missing most often?" %>
      <div class="mt-3 flex items-center justify-between"><span class="text-[10px] text-slate-400">Uses latest completed outputs</span><%= form.submit "Ask", class: "btn-primary cursor-pointer px-4 py-2" %></div>
    <% end %>
  </aside>
</div>
</div>
