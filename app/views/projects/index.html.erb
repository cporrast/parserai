<% content_for :title, "Projects · ParserAI" %>

<section class="mb-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
  <div class="max-w-2xl">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-indigo-600">Projects</p>
    <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Browse by project.</h1>
    <p class="mt-3 max-w-xl text-base leading-7 text-slate-500">Open a collection to manage its workflows, source history, exports, and data conversations.</p>
  </div>
  <%= link_to new_project_path, class: "btn-primary shrink-0" do %>
    <%= icon(:plus) %>
    Create a project
  <% end %>
</section>

<% unless llm_configured? %>
  <aside class="mb-8 flex flex-col gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-amber-950 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-bold">Connect OpenRouter to process pages</p>
      <p class="mt-1 text-xs leading-5 text-amber-800">Add <code class="rounded bg-amber-100 px-1.5 py-0.5">OPENROUTER_API_KEY</code> to your environment. You can create projects and runs without it.</p>
    </div>
    <span class="shrink-0 rounded-full bg-white px-3 py-1.5 text-xs font-semibold ring-1 ring-amber-200">Setup required</span>
  </aside>
<% end %>

<% if @projects.any? %>
  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    <% @projects.each do |project| %>
      <%= link_to project, class: "card group flex min-h-64 flex-col p-6 transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-lg hover:shadow-indigo-100/50" do %>
        <div class="mb-6 flex items-start justify-between">
          <span class="grid size-11 place-items-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100">
            <%= icon(:folder, classes: "size-6") %>
          </span>
          <%= icon(:arrow, classes: "size-5 text-slate-300 transition group-hover:translate-x-1 group-hover:text-indigo-500") %>
        </div>
        <h2 class="text-lg font-bold tracking-tight text-slate-950"><%= project.name %></h2>
        <p class="mt-2 line-clamp-3 flex-1 text-sm leading-6 text-slate-500"><%= project.description.presence || "No description yet. Open the project to begin extracting data." %></p>
        <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs font-medium text-slate-500">
          <span><%= pluralize(project.scrape_runs.size, "workflow") %></span>
          <span>Updated <%= time_ago_in_words(project.updated_at) %> ago</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card grid min-h-96 place-items-center border-dashed p-10 text-center">
    <div class="max-w-md">
      <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-indigo-50 text-indigo-600"><%= icon(:folder, classes: "size-7") %></span>
      <h2 class="mt-5 text-xl font-bold">Create your first project</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">Projects keep related scraping runs, source pages, outputs, and data conversations together.</p>
      <%= link_to "Start a project", new_project_path, class: "btn-primary mt-6" %>
    </div>
  </div>
<% end %>
