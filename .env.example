# Required for extraction runs and project chat
OPENROUTER_API_KEY=your_openrouter_key_here

# Provider settings (all optional)
LLM_BASE_URL=https://openrouter.ai/api/v1
SETUP_MODEL=openrouter/auto
EXTRACTION_MODEL=openrouter/auto
CHAT_MODEL=openrouter/auto
OPENROUTER_APP_NAME=ParserAI
# OPENROUTER_SITE_URL=https://your-parserai-host.example
LLM_REQUEST_TIMEOUT=180
LLM_MAX_PROMPT_CHARS=120000

# Content safeguards (all optional)
SCRAPER_MAX_RESPONSE_BYTES=5242880
SCRAPER_MAX_TEXT_LENGTH=80000
SCRAPER_MAX_STRUCTURED_PROMPT_LENGTH=60000
SCRAPER_MAX_RAW_HTML_PROMPT_LENGTH=100000
CHAT_MAX_CONTEXT_LENGTH=50000
APP_TIME_ZONE=America/Costa_Rica
